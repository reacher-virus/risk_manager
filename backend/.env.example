# All optional. Defaults give you a working local setup.
# RISK_DATA_DIR=./data                 # where data, models and the SQLite db live
# DATABASE_URL=postgresql+psycopg2://risk:risk@localhost:5432/risk   # default: SQLite in RISK_DATA_DIR
# API_KEYS=analystkey:analyst,adminkey:admin   # unset = open dev mode (everyone is admin)
# RISK_RATE_LIMIT_PER_MIN=240
# RISK_LABEL_DELAY_DAYS=14             # how late chargebacks/returns/fraud confirmations arrive
# RISK_WARMUP_DAYS=14                  # days excluded from training/eval (no history yet)
# RISK_COST_FP=150                     # default cost of a false alarm (INR)
# RISK_COST_FN=2500                    # default cost of missed fraud (INR)
# CORS_ORIGINS=http://localhost:5173

# ---- Authentication & security (see README "Authentication & security") ----
# APP_ENV=development                  # "production" = strict startup checks: refuses weak secrets, no HTTPS, no SMTP, wildcard CORS ...
# RISK_AUTH_REQUIRED=true              # false = open dev mode with no login (never in production)
# JWT_SECRET=                          # python -m app.auth.secrets  (>= 32 random chars; weak values are refused). Dev auto-generates data/.jwt_secret
# JWT_SECRET_PREVIOUS=                 # rotation: old secret still verifies tokens until they expire
# FRONTEND_URL=http://localhost:5173   # reset links are built from this, never from the Host header
# CORS_ORIGINS=http://localhost:5173   # explicit origins only (cookies + "*" is refused)
# ALLOWED_HOSTS=risk.example.com       # Host-header allowlist (required in production)
# FORCE_HTTPS=true  COOKIE_SECURE=true # redirect http->https, HSTS, Secure cookies (default on when APP_ENV=production)
# TRUSTED_PROXY_COUNT=1                # only when exactly one reverse proxy of yours sits in front
# SMTP_HOST=smtp.example.com  SMTP_PORT=587  SMTP_USER=  SMTP_PASSWORD=  MAIL_FROM="Risk Manager <no-reply@example.com>"
# AUTH_CHECK_MX=true                   # reject sign-up domains that cannot receive mail (needs DNS; default on in production)
# ALLOWED_EMAIL_DOMAINS=example.com    # optional: restrict sign-up to your organisation
# ADMIN_ALLOWED_IPS=203.0.113.0/24     # optional: admin sign-in only from these networks
# ADMIN_EMAIL= / ADMIN_PASSWORD=       # optional first-admin bootstrap (remove the password afterwards), or: python -m app.auth.create_admin
# WEBHOOK_ALLOWED_HOSTS=hooks.example.com   # optional allowlist for the critical-alert webhook
