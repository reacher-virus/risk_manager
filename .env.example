# Copy to .env (never commit it) before `docker compose up`.
DOMAIN=localhost                       # your real domain in production, e.g. risk.example.com
APP_ENV=production                     # production = strict startup checks (https, SMTP, strong secret ...). Use "development" to try it locally without SMTP
POSTGRES_PASSWORD=                     # required: a long random password
JWT_SECRET=                            # required: python -m app.auth.secrets   (rotate: put the old one in JWT_SECRET_PREVIOUS)
SMTP_HOST=                             # required in production: one-time codes are emailed
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Risk Manager <no-reply@your-domain>
ADMIN_EMAIL=                           # optional: creates the first admin on first start
ADMIN_PASSWORD=                        # optional: REMOVE after the first start (or use `python -m app.auth.create_admin` instead)
